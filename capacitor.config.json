{
  "appId": "com.example.app",
  "appName": "visa-music",
  "webDir": "dist",
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#00000000"
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#06080e",
      "androidSplashResourceName": "splash",
      "splashScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
